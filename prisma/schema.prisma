// BEMS Institute of Technology & Vocational Studies
// Core LMS Prisma Schema (PostgreSQL) - Phase 1 & 2: Core + Assessment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RESUBMISSION_REQUESTED
}

enum CourseStatus {
  ACTIVE
  UPCOMING
  ARCHIVED
}

enum DeliveryMode {
  PHYSICAL_LAB
  VIRTUAL_ZOOM
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID_FULL
}

enum LearningEventType {
  LESSON_STARTED
  LESSON_COMPLETED
  QUIZ_STARTED
  QUESTION_ANSWERED
  QUIZ_COMPLETED
  ASSIGNMENT_SUBMITTED
  ASSIGNMENT_GRADED
  AI_TUTOR_USED
}

enum NotificationCategory {
  CLASS
  GRADING
  PAYMENT
  GAMIFICATION
  ATTENDANCE
}

enum ReferralStatus {
  SIGNED_UP // referee created an account with this user's code
  CREDITED  // referee actually paid something -> referrer's credit was granted
}

model User {
  id           String         @id @default(cuid())
  clerkId      String?        @unique
  name         String
  email        String         @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  role         UserRole       @default(STUDENT)
  // Set by the user's own "Delete Profile" action — a soft delete, not a
  // real row deletion, so staff can still restore an account on request.
  // Blocks login and getSessionUser while set.
  deactivatedAt DateTime?
  // Bumped whenever the password changes (see POST /auth/reset-password) so
  // every session token issued before that point fails verification on its
  // next use — a stateless signed cookie has no other way to be revoked.
  tokenVersion Int            @default(0)
  enrollments      Enrollment[]
  progress         UserProgress[]
  quizAttempts     QuizAttempt[]
  submissions      Submission[]
  certificates     Certificate[]
  learningEvents   LearningEvent[]
  conceptMasteries ConceptMastery[]
  learningProfile  LearningProfile?
  passwordResetTokens PasswordResetToken[]
  notifications    Notification[]
  // Bring-a-friend (PRD §5.3): every user gets a permanent shareable code;
  // referredByCode records which code (if any) they signed up with.
  referralCode        String?   @unique
  referredByCode       String?
  creditBalanceNaira   Int       @default(0)
  referralsMade        Referral[]          @relation("ReferralsMade")
  attendanceRecords    AttendanceRecord[]
  graduateOutcomes     GraduateOutcome[]
  communityMessages    CommunityMessage[]
  communityMessageLikes CommunityMessageLike[]
  paymentTransactions  PaymentTransaction[]
  jobPlacements        JobPlacement[]
  // Which categories of staff-broadcast notifications (notifyStaff) this
  // user wants to receive — only affects staff-wide alerts, never a user's
  // own personal notifications (payment confirmed, submission graded, etc.),
  // which always send regardless of this preference.
  notifyCategories     NotificationCategory[] @default([CLASS, GRADING, PAYMENT, GAMIFICATION, ATTENDANCE])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// A single site-wide settings row (admin console "Website Settings"). Always
// read/written by a fixed id so there's exactly one row, no per-tenant needs.
model SiteSettings {
  id                String   @id @default("singleton")
  siteName          String   @default("BEMS Institute of Technology & Vocational Studies")
  copyrightText     String   @default("")
  siteEmail         String   @default("")
  description       String   @default("") @db.Text
  contactPhone      String   @default("")
  supportEmail      String   @default("")
  contactAddress    String   @default("") @db.Text
  // "enable" | "disable" | "request" — enforced on POST /api/auth/signup.
  allowRegistration String   @default("enable")
  updatedAt         DateTime @updatedAt
}

// One row per successful referral signup — created when the referee
// registers with a code, flipped to CREDITED (and the referrer's balance
// bumped by creditNaira) the first time the referee's enrollment shows any
// real payment, so a friend who signs up but never pays doesn't earn credit.
model Referral {
  id          String         @id @default(cuid())
  referrerId  String
  referrer    User           @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId   String         @unique
  refereeName String
  status      ReferralStatus @default(SIGNED_UP)
  creditNaira Int            @default(5000)
  creditedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([referrerId])
}

// A public, admin-curated "where they are now" entry (PRD §5.3) — never
// auto-published from a certificate, since putting someone's name/photo on
// a public marketing page needs their consent, not just a passing grade.
model GraduateOutcome {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  headline  String
  company   String?
  quote     String?  @db.Text
  photoUrl  String?
  featured  Boolean  @default(false)
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([courseId])
}

enum PlacementStatus {
  SEEKING
  INTRODUCED
  HIRED
}

enum PlacementType {
  BEMS_INTERNAL
  PARTNER
}

enum PlacementFeeStatus {
  NONE
  INVOICED
  PAID
}

// The PRD's "finished -> help into a job" pipeline (§6.2) and second
// revenue stream (§3.4: BEMS hiring its own grads saves recruiter cost;
// partner companies can be charged an introduction fee). A row is created
// automatically (SEEKING) the moment a student earns a Certificate — see
// POST /submissions/:id/grade — and staff move it forward from /admin.
// Deliberately separate from GraduateOutcome: that model is a published,
// consent-gated marketing record; this one is an internal pipeline/revenue
// record that always exists once a student finishes, consent or not.
model JobPlacement {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status        PlacementStatus     @default(SEEKING)
  placementType PlacementType?
  // Free text, same convention as QrScan.source / GraduateOutcome.company —
  // "BEMS Group" or a partner company's name. No separate company directory
  // yet; add one later if repeat-partner relationships need tracking.
  employerName  String?
  hiredAt       DateTime?
  // What a PARTNER employer owes BEMS for this hire (Naira) — null for
  // BEMS_INTERNAL hires or where no fee applies. Kept on the placement
  // itself rather than in the PaymentTransaction ledger: that ledger is
  // specifically "a student paid BEMS," a structurally different flow from
  // "BEMS invoices a company."
  feeAmount     Int?
  feeStatus     PlacementFeeStatus  @default(NONE)
  notes         String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([status])
}

// A single scheduled live class (Zoom or physical lab) for a course — the
// PRD's "miss two classes -> automatic check-in" (§6.2) needs real sessions
// to be absent FROM, not just lesson-video progress.
enum LiveSessionType {
  CLASS
  WELCOME
}

model LiveSession {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  scheduledAt DateTime
  // External Zoom/Meet-style join link — this app doesn't host video itself,
  // it links out, same as most real LMS platforms.
  meetingUrl  String?
  // PRD §4.2: "A welcome session before class starts: a live 'here's why
  // you'll finish' session." A WELCOME session is scheduled/attended the
  // same way as a CLASS one; marking a student absent from one triggers an
  // immediate WhatsApp no-show message (not the "missed 2 in a row" rule
  // regular classes use), since there's only ever one per cohort.
  type        LiveSessionType @default(CLASS)
  createdAt   DateTime @default(now())
  attendance  AttendanceRecord[]

  @@index([courseId])
}

// A message in a fixed, code-defined community channel (channels are not a
// DB table — see COMMUNITY_CHANNELS on the frontend — only messages need
// real persistence so they survive a refresh and are visible to everyone).
model CommunityMessage {
  id          String   @id @default(cuid())
  channelId   String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  codeSnippet String?  @db.Text
  likes       Int      @default(0)
  likedBy     CommunityMessageLike[]
  createdAt   DateTime @default(now())

  @@index([channelId, createdAt])
}

// One row per (message, user) like — the `likes` counter above used to be a
// bare increment with no dedupe, so a single user could inflate any
// message's count arbitrarily by re-calling the endpoint. The unique
// constraint here is what actually stops that.
model CommunityMessageLike {
  id        String           @id @default(cuid())
  messageId String
  message   CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([messageId, userId])
}

model AttendanceRecord {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  present   Boolean
  markedAt  DateTime    @default(now())

  @@unique([sessionId, userId])
  @@index([userId])
}

model Course {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  badge        String        @default("")
  tutor        String
  tutorRole    String
  schedule     String        @default("")
  duration     String        @default("")
  delivery     String        @default("")
  tagline      String
  priceFull    Int
  priceParts   Int
  deposit      Int
  finalProject String
  isPublished  Boolean       @default(true)
  status       CourseStatus  @default(ACTIVE)
  color        String        @default("#7928CA") // for analytics chart display
  modules      Module[]
  quizzes      Quiz[]
  assignments  Assignment[]
  enrollments  Enrollment[]
  certificates Certificate[]
  concepts     Concept[]
  liveSessions LiveSession[]
  graduateOutcomes GraduateOutcome[]
  paymentTransactions PaymentTransaction[]
  jobPlacements JobPlacement[]
  leads Lead[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Module {
  id        String   @id @default(cuid())
  title     String
  order     Int
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model Lesson {
  id            String         @id @default(cuid())
  title         String
  slug          String
  description   String         @db.Text
  videoUrl      String?        // Mux playback ID or Cloudflare R2 stream URL
  duration      String         @default("15:00")
  order         Int
  isFreePreview Boolean        @default(false)
  moduleId      String
  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userProgress  UserProgress[]
  concepts      LessonConcept[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([moduleId])
}

model Enrollment {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status           EnrollmentStatus @default(ACTIVE)
  paymentPlan      String           @default("full") // "full" or "installment"
  amountPaid       Int              @default(0)
  totalDue         Int              @default(0)
  paymentStatus    PaymentStatus    @default(PENDING)
  deliveryMode     DeliveryMode     @default(PHYSICAL_LAB)
  paymentReference String?
  source           String?          @default("website") // banner/QR label — free text, see QrScan
  cohortId         String?
  cohort           Cohort?          @relation(fields: [cohortId], references: [id])
  // PRD §4.1 step 5 / §6.2: "a welcome call before class starts... anyone
  // who doesn't show gets a personal WhatsApp message." Staff-scheduled
  // (see PATCH /admin/enrollments/:id/welcome-call), not self-booked.
  welcomeCallStatus WelcomeCallStatus @default(NOT_SCHEDULED)
  welcomeCallAt     DateTime?
  // PRD §4.2: "A public goal: each student states their goal in the class
  // group... saying it out loud, in front of others." Visible to every
  // other student in the same cohort+course (see GET /lms/class-goals) —
  // the lightest version of a "class group" this app has, short of
  // building real per-cohort chat channels.
  goalStatement     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

enum WelcomeCallStatus {
  NOT_SCHEDULED
  SCHEDULED
  COMPLETED
  NO_SHOW
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

// Immutable, append-only record of every Paystack charge attempt — the
// source of truth for "did money actually move," independent of whatever
// Enrollment.paymentStatus/amountPaid currently say (those are a derived
// running total, this is the audit trail behind them). One row per charge,
// so an installment plan accumulates several rows against the same
// userId+courseId pair as the student pays across the cohort.
model PaymentTransaction {
  id              String                   @id @default(cuid())
  reference       String                   @unique
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paymentPlan     String // "full" or "installment" — which plan this charge was made under
  amount          Int // Naira, whole currency unit — matches Course.priceFull/priceParts/deposit
  status          PaymentTransactionStatus @default(PENDING)
  channel         String? // "card" / "bank" / "ussd" etc. — from Paystack's response, or "bank" for a staff-confirmed manual transfer
  gatewayResponse String?
  paidAt          DateTime?
  rawPayload      Json? // full Paystack verify/webhook payload, kept for dispute resolution
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([userId])
  @@index([courseId])
}

// One admissions intake round (e.g. "October 2026"). Enrollments link to
// whichever cohort is active when they're created; targets here drive the
// admin analytics dashboard's goal-vs-actual figures.
model Cohort {
  id             String       @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  targetStudents Int          @default(80)
  targetRevenue  Int          @default(0)
  // PRD §4.1 step 1 ("See our advert," target 10,000) is an outdoor
  // banner/flier impression count — no website can measure how many people
  // saw a physical banner before scanning it. This is a manual staff
  // estimate (e.g. from print-run size and foot traffic), set via
  // PATCH /admin/cohort, not something the app observes.
  estimatedAdViews Int        @default(0)
  enrollments    Enrollment[]
  createdAt      DateTime     @default(now())
}

// Append-only log of banner/QR landing-page visits (see /subscriptions and
// the QR Studio), independent of whether the visit converted to an
// enrollment. Aggregated by `source` for the admin banner-yield dashboard —
// registrations are the subset of a source's scans whose visitor enrolled.
model QrScan {
  id        String   @id @default(cuid())
  source    String
  courseId  String?
  createdAt DateTime @default(now())

  @@index([source])
}

// PRD §4.1 step 2 ("Visit the sign-up page," target 2,000) — a real,
// anonymous page-view log for the two actual funnel-entry pages (home,
// subscriptions), independent of whether the visit carried a QR/UTM
// source. visitorId is a random id generated client-side into
// localStorage (see src/lib/visitor.ts) — no PII, no account link;
// dedup-per-visitor-per-day is enforced in the route, not a DB constraint,
// so no separate "day" column is needed.
model PageView {
  id        String   @id @default(cuid())
  page      String // "home" | "subscriptions"
  visitorId String
  source    String? // UTM/QR source, if present on this visit
  createdAt DateTime @default(now())

  @@index([page, visitorId])
  @@index([page, createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DROPPED
}

// PRD §4.1 step 3 ("Register interest," target 600) — the lightweight
// "ask just 3 things" lead form (name, phone, course interest) that sits
// before the full payment/subscriptions checkout. No account is created
// here; a lead only becomes a real User/Enrollment if they later check out.
model Lead {
  id        String     @id @default(cuid())
  name      String
  phone     String
  courseId  String?
  course    Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  source    String?    @default("website") // banner/QR label, same convention as QrScan.source
  status    LeadStatus @default(NEW)
  notes     String?    @db.Text
  createdAt DateTime   @default(now())

  @@index([courseId])
  @@index([status])
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted Boolean  @default(false)
  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
}

// ---------------------------------------------
// PHASE 2 — ASSESSMENT MODELS
// ---------------------------------------------

model Quiz {
  id           String        @id @default(cuid())
  title        String
  description  String
  passingScore Int           @default(70) // Percentage required to pass
  courseId     String
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]
  attempts     QuizAttempt[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([courseId])
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt        String
  options       String[] // Stored as array of strings
  correctOption Int      // Index of correct option (0-based)
  explanation   String?
  concepts      QuestionConcept[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score     Int      // Percentage scored (0-100)
  passed    Boolean
  answers   Json     // Map of questionId -> selectedOptionIndex
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([quizId])
}

enum AssignmentType {
  MILESTONE
  CAPSTONE
}

model Assignment {
  id           String       @id @default(cuid())
  title        String
  brief        String       @db.Text
  requirements String[]
  rubric       Json         // [{ criteria: string, points: number }]
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions  Submission[]
  // PRD §4.2: "Small projects along the way, not one big exam... every
  // 2-3 weeks." type distinguishes a milestone (practice, graded but does
  // NOT issue a certificate) from the final capstone (does). order sorts
  // a course's assignments in the curriculum's actual sequence. Existing
  // single-assignment courses default to CAPSTONE/99 (last) so they keep
  // behaving exactly as before without a data migration.
  type         AssignmentType @default(CAPSTONE)
  order        Int          @default(99)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([courseId])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUrl    String
  liveDemoUrl  String?
  notes        String?          @db.Text
  status       SubmissionStatus @default(SUBMITTED)
  score        Int?             // Out of 100
  feedback     String?          @db.Text
  gradedBy     String?          // Instructor name / ID
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, userId])
  @@index([userId])
}

model Certificate {
  id           String   @id @default(cuid())
  certNumber   String   @unique // e.g. BEMS-CERT-2026-WD-8819
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  gradeTitle   String   @default("Distinction") // e.g. Distinction, Honors, Merit
  finalScore   Int      // Composite score out of 100
  qrVerifyUrl  String
  issuedAt     DateTime @default(now())

  @@unique([userId, courseId])
  @@index([certNumber])
}

// ---------------------------------------------------------------
// THE CORE PERSONALIZATION LOOP
//
// Lessons/Questions teach Concepts (LessonConcept/QuestionConcept) ->
// a student's real activity (quiz answers, lesson completion) is logged
// as LearningEvents -> each relevant event recomputes that student's
// ConceptMastery -> the recommendation engine (src/lib/learning-engine.ts)
// reads ConceptMastery + LearningEvents to explain, in plain evidence,
// what to study next. Deliberately rule-based, not ML — see that file's
// header comment for why.
// ---------------------------------------------------------------

model Concept {
  id              String            @id @default(cuid())
  name            String
  description     String?
  courseId        String
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parentConceptId String?
  parentConcept   Concept?          @relation("ConceptHierarchy", fields: [parentConceptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childConcepts   Concept[]         @relation("ConceptHierarchy")
  lessons         LessonConcept[]
  questions       QuestionConcept[]
  masteries       ConceptMastery[]
  events          LearningEvent[]
  createdAt       DateTime          @default(now())

  @@index([courseId])
}

// What a lesson teaches — used to point a weak-concept recommendation at
// something to (re-)watch. `importance` (1-5) lets a lesson teach several
// concepts without weighting them all equally.
model LessonConcept {
  lessonId   String
  conceptId  String
  importance Int     @default(3)
  lesson     Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept    Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([lessonId, conceptId])
  @@index([conceptId])
}

// What a quiz question actually tests — this is the ground truth every
// ConceptMastery score is computed from.
model QuestionConcept {
  questionId String
  conceptId  String
  importance Int      @default(3)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept    Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([questionId, conceptId])
  @@index([conceptId])
}

// Append-only activity log — the raw material the personalization loop
// learns from. Written as a side effect of the existing progress/quiz/
// submission API routes, never a separate tracking call the client has to
// remember to make.
model LearningEvent {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String?
  lessonId  String?
  conceptId String?
  concept   Concept?          @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  eventType LearningEventType
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([conceptId])
}

// One row per (student, concept) — recomputed from scratch on every
// relevant LearningEvent, not incrementally patched, so it can never drift
// from the events that produced it.
model ConceptMastery {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId       String
  concept         Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  masteryScore    Float     @default(0) // correctAttempts / attempts
  confidence      Float     @default(0) // how much to trust masteryScore, from attempt count
  attempts        Int       @default(0)
  correctAttempts Int       @default(0)
  lastPracticedAt DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, conceptId])
  @@index([conceptId])
}

model LearningProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningGoal    String?
  experienceLevel String    @default("BEGINNER")
  learningStreak  Int       @default(0)
  lastActiveAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Append-only log backing rate-limiting on password/code-guessing endpoints
// (see src/lib/rate-limit.ts). `key` namespaces which limiter it belongs to,
// e.g. "login:<email>" for /api/auth/login or a fixed key for the shared
// admin access code — a Postgres table rather than an in-memory counter so
// the lockout survives a dev-server restart and isn't per-instance.
model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// A password-reset link's server-side half. Only tokenHash (SHA-256 of the
// random token actually emailed/logged to the user) is ever stored, so a
// database leak alone can't be used to reset anyone's password. Single-use
// via usedAt, and short-lived via expiresAt — see /api/auth/request-reset
// and /api/auth/reset-password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Redemption record for one generated practice-question token (see
// /api/learning/practice-question). The token itself is a signed, stateless
// JWT-like blob carrying the correct answer — this table is the one piece of
// server state needed to make it single-use: answering inserts a row keyed
// on the token's jti, and a unique-constraint violation on replay is what
// rejects a second submission of the same token.
model PracticeAttempt {
  id        String   @id @default(cuid())
  jti       String   @unique
  createdAt DateTime @default(now())
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String               @db.Text
  category  NotificationCategory @default(CLASS)
  linkUrl   String?
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
}

